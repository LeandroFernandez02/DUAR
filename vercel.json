{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "regions": ["gru1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{server/assets/**,node_modules/pdfkit/js/data/**}"
    }
  }
}
