# ============================================================================
#  Variables de entorno del backend DUAR
#  Copiar a `server/.env` y completar. NUNCA commitear el .env real.
# ============================================================================

# ── Base de datos ───────────────────────────────────────────────────────────
# Hay dos formas; si DATABASE_URL está presente, gana sobre las variables sueltas.
#
# (A) Supabase / producción — una sola cadena, con SSL obligatorio.
#     Se copia de: Supabase → Project Settings → Database → Connection string
#
#     Para el backend corriendo como servidor normal (local, Railway, Render)
#     usar el **Session pooler** (puerto 5432 del host `...pooler.supabase.com`):
#     es IPv4, mientras que la conexión directa `db.<ref>.supabase.co` es IPv6
#     y suele no resolver desde una red hogareña.
#
#     Para un deploy **serverless** (Vercel) usar el **Transaction pooler**
#     (puerto 6543): cada invocación abre y cierra conexiones, y sin pooler de
#     transacción se agota el límite de conexiones de Postgres.
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# PGPOOL_MAX=10

# (B) PostgreSQL local — desarrollo contra la base `duar-test` en la PC.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=duar-test
PGUSER=postgres
PGPASSWORD=

# ── Servidor ────────────────────────────────────────────────────────────────
# El proxy de Vite apunta fijo a localhost:3001 (ver vite.config.ts).
PORT=3001

# ── Sesiones (Decisión E: tokens opacos en PostgreSQL, revocables) ──────────
SESION_HORAS=12

# ── Correo (CU-02 confirmación de cuenta · CU-03 recuperar contraseña) ──────
# Gmail: no es la contraseña normal de la cuenta. Hace falta:
#   1. Activar la verificación en 2 pasos en myaccount.google.com/security
#   2. Generar una "Contraseña de aplicación" en
#      myaccount.google.com/apppasswords (elegir "Otra" y ponerle un nombre,
#      ej. "DUAR backend"). Da un código de 16 caracteres, sin espacios acá.
# Si estas dos variables faltan, el sistema sigue funcionando: el correo
# simplemente no sale y queda un aviso en la consola del servidor.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Base para armar los links que van por correo (confirmar-email, restablecer
# contraseña). En desarrollo es el puerto de Vite; en Vercel, el dominio real.
FRONTEND_URL=http://localhost:5173
