{
  "name": "duar-api",
  "version": "1.0.0",
  "description": "API del Sistema DUAR — capa Modelo/Controlador (MVC)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unidad": "node --test \"tests/unidad/*.test.js\"",
    "test:informe": "node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/reporter-informe.mjs --test-reporter-destination=tests/INFORME-PRUEBAS.md \"tests/**/*.test.js\"",
    "limpiar-pruebas": "node src/scripts/limpiar-datos-de-prueba.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "nodemailer": "^9.0.6",
    "pg": "^8.13.1"
  }
}
